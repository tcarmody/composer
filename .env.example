# Composer configuration. Copy to .env and fill in.

# Auth for the internal API (frontend -> backend). Leave empty for local dev.
# REQUIRED in the cloud: the backend is publicly reachable, so set a strong key
# and enter the same value in the Mac app's Settings > API Key.
AUTH_API_KEY=

# Auth for the public ingest API (DataPoints -> Composer). Leave empty for local dev.
# REQUIRED in the cloud: must match the ingest key configured on DataPoints.
COMPOSER_INGEST_KEY=

# DataPoints backend URL (used by per-item refresh to ask DataPoints to re-promote).
# Local dev: http://127.0.0.1:5005 — Cloud: the Railway DataPoints URL.
DATAPOINTS_URL=https://macreader-production.up.railway.app
# Optional API key for DataPoints, if it requires one.
DATAPOINTS_API_KEY=

# ── Local→cloud sync relay ──────────────────────────────────────────
# Topology: the LOCAL backend is the single writer (the Mac app points at
# it); the Railway instance is a read-mostly replica serving the web app.
# Set these on the LOCAL instance only — leave both empty in the cloud.
#
# Cloud Composer base URL to push local writes to. Setting this enables
# the outbox worker; writes queue while offline and flush on reconnect.
# SYNC_TARGET_URL=https://composer.up.railway.app
# Sent as X-Ingest-Key; must equal the cloud's COMPOSER_INGEST_KEY.
# SYNC_API_KEY=
# Outbox poll interval in seconds.
# SYNC_INTERVAL=5
# How often to pull cloud-ingested items down, in seconds. Promotions made
# from the cloud DataPoints web UI land on the Railway instance and flow
# back to the local one through GET /v1/sync/items.
# SYNC_PULL_INTERVAL=30

# LLM provider (not used until Phase 3 / Ask mode)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# VOYAGE_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=

# Server
# PORT is injected by Railway in the cloud; 5006 is the local default.
PORT=5006
# Local dev: ./data/composer.db — Cloud: point at the Railway Volume mount,
# e.g. /data/composer.db, so the database survives redeploys.
DB_PATH=./data/composer.db
LOG_LEVEL=INFO
# Browser web app origins (CORS). Not needed by the native Mac app.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
